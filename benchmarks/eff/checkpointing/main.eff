
type input
  = Enter of int
  | Commit
  | Undo
  | Done

type checkpoint
  = None
  | Some of (unit -> (checkpoint -> int))

effect Read: unit -> input
effect Emit: int -> unit
effect Save: unit -> unit
effect Retry: unit -> unit

let input n program = (
  handle program () with
  | x -> fun _ -> x
  | effect (Read ()) k ->
    fun i ->
      let i' = i + 1 in
      if (i >= n)
        then k Done i'
      else if (i mod 3 = 0)
        then k Commit i'
      else if (i mod 5 = 0)
        then k Undo i'
      else
        k (Enter i') i'
  ) n


let checkpointing program =
  let rec restart _ =
    handle program () with
    | x -> fun _ -> x
    | effect (Retry()) _ ->
      (fun cp ->
        match cp with
        | Some k -> k () cp
        | None -> restart () cp)
    | effect (Save()) k ->
      (fun _ -> k () (Some k)) in

  restart () None


let sum stream = (
  handle stream () with
  | _ -> fun s -> s
  | effect (Emit(n)) k ->
    fun s -> k () (s + n)
  ) 0

let rec user _ =
  match perform (Read ()) with
  | Enter(n) ->
    perform (Emit n);
    user ()
  | Commit ->
    perform (Save ());
    user ()
  | Undo ->
    perform (Retry ());
    user ()
  | Done ->
    ()

let run n =
  input(n) (fun _ -> checkpointing (fun _ -> sum(user)) )
